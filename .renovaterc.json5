{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigests',
    'github>frecklelabs/k8s//.renovate/autoMerge.json5',
    'github>frecklelabs/k8s//.renovate/customManagers.json5',
    'github>frecklelabs/k8s//.renovate/groups.json5',
    'github>frecklelabs/k8s//.renovate/labels.json5',
    'github>frecklelabs/k8s//.renovate/semanticCommits.json5',
    ':automergeBranch',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':timezone(America/Chicago)',
    // Defines the custom.talos-factory datasource, which lists the Talos
    // versions the Image Factory can actually build. Must come before
    // infraPackages so our per-cluster commit rules still take precedence.
    'github>home-operations/renovate-presets//apps/talosFactory.json5#11.0.0',
    'github>frecklelabs/k8s//.renovate/infraPackages.json5',
  ],
  // The merge queue tests each PR against the latest main before merging, so
  // a PR that is merely behind main is fine. Rebase only on conflicts instead
  // of re-running CI on every open Renovate PR each time main moves.
  rebaseWhen: 'conflicted',
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  // mise.toml: the kubectl, flux and kustomize that CI and agent sessions use.
  mise: {
    enabled: true,
  },
  flux: {
    managerFilePatterns: [
      '/(^|/)apps/.+\\.ya?ml$/',
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)apps/.+\\.ya?ml$/',
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)apps/.+\\.ya?ml$/',
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
    ignorePaths: [
      'kubernetes/**/flux-system/**',
    ],
  },
  packageRules: [
    {
      // Renovate PRs are the infra agent's to handle (cockpit C-194), so
      // nobody is requested by default. The one exception is GitHub Actions
      // updates under .github/, which need Nicole's review anyway: ask her
      // directly, so she hears about those PRs and no others.
      matchFileNames: ['.github/**'],
      reviewers: ['nicolerenee'],
    },
    {
      matchManagers: ['mise'],
      semanticCommitScope: 'toolchain',
      commitMessageTopic: '{{depName}}',
    },
    {
      matchManagers: ['mise'],
      matchDepNames: ['kubectl', 'flux2'],
      prBodyNotes: [
        'Pinned to what the clusters run: merge with the cluster upgrade, not ahead of it.',
      ],
    },
    {
      // kustomize tags its CLI releases kustomize/vX.Y.Z.
      matchManagers: ['mise'],
      matchDepNames: ['aqua:kubernetes-sigs/kustomize'],
      extractVersion: '^kustomize/v(?<version>.+)$',
    },
    {
      // Jellyfin publishes a two-segment tag (12.0) while we are pinned to a
      // three-segment one (10.11.11). Renovate's default `docker` versioning
      // requires both to have the same number of segments —
      // lib/modules/versioning/docker/index.ts isCompatible():
      //   parsed1.release.length === parsed2.release.length
      // — so 12.0 is silently filtered out and no PR is ever opened. There is
      // no 12.0.0 tag upstream to match instead. semver-coerced normalises
      // "12.0" to "12.0.0", which compares correctly and keeps working if
      // Jellyfin goes back to three segments.
      matchPackageNames: ['ghcr.io/jellyfin/jellyfin'],
      versioning: 'semver-coerced',
    },
    {
      // MariaDB 13.x is a rolling (non-LTS) series: taking it means riding
      // 13.1/13.2 until the next LTS, the major bump needs mariadb-upgrade via
      // the operator (updateStrategy.mariadbAutoUpgradeEnabled), and there is
      // no in-place downgrade once 13 touches the datadir. mariadb-main has no
      // operator-managed backup today, so stay on the 12.3 LTS line and revisit
      // when the next LTS (13.3) ships. Exact name match, so mariadb-operator
      // charts are unaffected.
      matchDatasources: ['docker'],
      matchPackageNames: ['mariadb'],
      allowedVersions: '<13',
    },
    {
      // ISC numbers BIND so that even minors (9.18, 9.20) are stable/ESV
      // branches and odd minors (9.19, 9.21) are development branches. The
      // image tags don't mark the difference, so without this Renovate offers
      // every dev branch as an ordinary minor bump. Matches both "9.20" and
      // "9.20.x" tags.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/internetsystemsconsortium/bind9'],
      allowedVersions: '/^9\\.\\d*[02468](\\.|$)/',
    },
    {
      // Connect chart 2.3.0 switched op-credentials from an env var holding
      // base64-encoded JSON to a mounted file holding raw JSON. The secret is
      // created out of band (bootstrap/setup-1password.sh) in the old format,
      // so a plain bump would break Connect on both clusters. Lift this when
      // the secret is re-created in the new format in the same change.
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/1password/connect'],
      allowedVersions: '<2.3.0',
    },
    {
      // When the kubernetes-sigs/gateway-api tag in
      // scripts/vendor-gateway-api-crds.sh is bumped, re-run the vendor
      // script to regenerate the CRD YAML files in the same PR. Requires
      // RENOVATE_ALLOWED_POST_UPGRADE_COMMANDS to allowlist the script.
      matchDepNames: ['kubernetes-sigs/gateway-api'],
      postUpgradeTasks: {
        commands: ['scripts/vendor-gateway-api-crds.sh'],
        fileFilters: ['kubernetes/apps/networking/gateway-api/**'],
        executionMode: 'branch',
      },
    },
  ],
}
